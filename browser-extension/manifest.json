{
  "manifest_version": 3,
  "name": "HuntMaster 2.0",
  "version": "3.4.0",
  "description": "Automatically detects the game you're playing on casino sites and updates your HuntMaster Now Playing widget",
  "homepage_url": "https://huntmaster.vercel.app",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://huntmaster.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bc.game/*",
        "*://bc.game/*",
        "*://*.videoslots.com/*",
        "*://videoslots.com/*",
        "*://www.videoslots.com/*",
        "*://*.vave.com/*",
        "*://vave.com/*",
        "*://*.gamba.com/*",
        "*://gamba.com/*",
        "*://*.gamba.io/*",
        "*://gamba.io/*",
        "*://*.cryptocasino.com/*",
        "*://cryptocasino.com/*",
        "*://*.cryptocasino.io/*",
        "*://cryptocasino.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://huntmaster.vercel.app/*"
      ],
      "js": ["huntmaster-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}


